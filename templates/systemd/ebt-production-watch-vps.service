[Unit]
Description=EBT read-only product health monitor on VPS
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ebt-watch
Group=ebt-watch
WorkingDirectory=/opt/ebt-production-watch
Environment=EBT_NOTIFY=false
ExecStart=/usr/bin/python3 /opt/ebt-production-watch/production_watch.py --output /var/lib/ebt-production-watch/report.json
StateDirectory=ebt-production-watch
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TimeoutStartSec=2min
StandardOutput=journal
StandardError=journal
