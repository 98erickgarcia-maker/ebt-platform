[Unit]
Description=EBT read-only GitHub schedule watchdog
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ebt-watch
Group=ebt-watch
WorkingDirectory=/opt/ebt-platform
EnvironmentFile=-/etc/ebt-watch.env
ExecStart=/usr/bin/python3 /opt/ebt-platform/scripts/ops/schedule_watchdog.py --state /var/lib/ebt-watch/state.json
StateDirectory=ebt-watch
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
TimeoutStartSec=8min
StandardOutput=journal
StandardError=journal

