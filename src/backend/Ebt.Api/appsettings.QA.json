{
  "Ebt": {
    "EnvironmentName": "QA",
    "SyntheticDataEnabled": true,
    "RequirePrivateConfiguration": false,
    "RequiredPrivateConfigurationKeys": []
  },
  "QaPersistence": {
    "Enabled": true,
    "SqlHost": "127.0.0.1",
    "SqlPort": 1433,
    "SqlUser": "sa",
    "DatabaseName": "EbtQa_App",
    "SqlPasswordEnvironmentVariable": "EBT_QA_SQL_PASSWORD",
    "BlobConnectionEnvironmentVariable": "EBT_QA_BLOB_CONNECTION",
    "BlobContainerName": "ebt-qa-app"
  }
}
