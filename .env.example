# Existing shared Azure SQL. No new database, SKU or paid plan.
# Runtime identity must be dedicated to ebt_connect only.
ConnectionStrings__Platform=Server=tcp:sql-crm-casst-dev-crmenterprise98.database.windows.net,1433;Initial Catalog=sqldb-crm-casst-dev-v2;Encrypt=True;TrustServerCertificate=False;Authentication=Active Directory Managed Identity
ASPNETCORE_ENVIRONMENT=Production
Platform__KeyStorage=sql
# Certificate PFX Base64 and password must come from host secrets, never this file.
# Platform__KeyCertificateBase64 supplied by host secret store.
# Files remain supported for Windows local QA with Platform__KeyPath and DPAPI.
# Platform__KeyCertificatePassword supplied by host secret store, never commit it.
# Platform__TrustedProxies: explicit observed ingress IPs separated by semicolons.
# Never set ASPNETCORE_FORWARDEDHEADERS_ENABLED=true or accept every sender.
Platform__RunWorkers=true
Meta__Enabled=false
WazVox__Enabled=false
# WazVox__Apps__wz-ebt__WorkspaceId: confirmed with GET /me (not an EBT tenant ID).
# WazVox__Apps__wz-ebt__SigningSecret: returned by integration-specific subscription, host secret store only.
# WazVox__Connections__ebt-wazvox__ApiKey: private credential, never frontend or Git.
# Meta__ApiVersion: verified version for the account; no implicit version fallback.
# Meta__Apps__<appKey>__AppSecret / VerifyToken and Meta__Connections__<reference>__AccessToken via secret store.
Documents__ScannerEnabled=false
# Production approvals remain blocked until the exact uploaded version has a clean scan.
# Documents__ScannerHost / ScannerPort: approved private ClamAV service, configured by deployment owner.
