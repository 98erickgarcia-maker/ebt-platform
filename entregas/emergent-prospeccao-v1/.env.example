# Acrescentar somente EP_* ao ambiente existente. NÃO substituir seus MS_*,
# AZURE_*, OWNER_EMAIL, FRONTEND_URL, MONGO_URL ou DB_NAME por valores vazios.
EP_WORKSPACE=ebt-enterprise
EP_MONTHLY_LIMIT=3000
EP_DAILY_EMAIL_LIMIT=20
# Conexão automática como o disparador. Usa MS_* ou AZURE_* existentes.
EP_OUTLOOK_MODE=application
# Vazio: lê SENDER_MAILBOX ou settings.sender_mailbox já existente.
EP_SENDER_MAILBOX=
# Liberar após teste real destinado a um endereço controlado pelo responsável.
EP_EMAIL_SEND_ENABLED=false
# Somente alternativa delegated necessita destes valores novos:
EP_MS_REDIRECT_URI=
EP_TOKEN_KEY=
# API oficial do WhatsApp: secretos ficam exclusivamente no ambiente servidor.
EP_WA_PHONE_ID=
EP_WA_TOKEN=
EP_WA_APP_SECRET=
EP_WA_VERIFY_TOKEN=
EP_WA_VERSION=v23.0
EP_WA_SEND_ENABLED=false
EP_WA_MAX_COST_BRL=0
EP_WA_TEMPLATE_COST_BRL=0
