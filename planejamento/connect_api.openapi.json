  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Credencial candidata da API; estratégia de sessão/provedor deve ser fechada em P04. Não embutir token."
      },
      "metaSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Hub-Signature-256",
        "description": "Representação documental de assinatura HMAC; não é uma API key. Validar bytes originais e segredo de app conforme contrato vigente do provedor."
      }
    },
    "schemas": {
      "ReplyRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "content",
          "contentType"
        ],
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1
          },
          "contentType": {
            "type": "string",
            "const": "text"
          },
          "replyToMessageId": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "QueuedReply": {
        "type": "object",
        "required": [
          "messageId",
          "operationId",
          "status",
          "statusUrl"
        ],
        "properties": {
          "messageId": {
            "type": "string",
            "minLength": 1
          },
          "operationId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "accepted",
              "sent",
              "delivered",
              "read",
              "failed",
              "unknown"
            ]
          },
          "statusUrl": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Message": {
        "type": "object",
        "required": [
          "id",
          "conversationId",
          "direction",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "conversationId": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "type": "string",
            "enum": [
              "incoming",
              "outgoing",
              "internal"
            ]
          },
          "content": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "received",
              "queued",
              "accepted",
              "sent",
              "delivered",
              "read",
              "failed",
              "unknown"
            ]
          },
          "providerMessageId": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MessagePage": {
        "type": "object",
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Message"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code",
          "traceId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "traceId": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  }
